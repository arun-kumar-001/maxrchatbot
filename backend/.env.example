# MAXR Backend Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI Providers
# AI_PROVIDER selects the primary chat provider: openai | groq | gemini
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=gsk_your-groq-key
GROQ_MODEL=llama-3.1-70b-versatile
# Google Gemini (uses the OpenAI-compatible endpoint). GOOGLE_API_KEY is accepted as an alias.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
# Automatic chat fallback order on 429 / quota / temporary outage (primary is tried first).
AI_FALLBACK_ORDER=gemini,groq,openai

# Embeddings (for the RAG knowledge base)
# EMBEDDING_PROVIDER: openai (text-embedding-3-small, 1536-dim) | gemini (gemini-embedding-001, 3072-dim)
# Defaults to gemini when AI_PROVIDER=gemini, otherwise openai.
# NOTE: changing this changes the vector dimension; recreate/reindex the Qdrant collection.
EMBEDDING_PROVIDER=openai

# Qdrant
# Local: http://localhost:6333 (no key). Hosted Qdrant Cloud: set the cloud URL + QDRANT_API_KEY.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=maxr-knowledge

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173